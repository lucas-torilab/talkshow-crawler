PYANNOTE_API_KEY=sk_your_pyannote_api_key_here

# Optional: route youtube_transcript_api's caption-fetch requests through a proxy,
# to work around YouTube IP-blocking that endpoint after high request volume.
# Webshare (rotating residential proxies) takes priority if both are set.
# WEBSHARE_PROXY_USERNAME=your_webshare_username
# WEBSHARE_PROXY_PASSWORD=your_webshare_password
# YOUTUBE_PROXY_URL=http://user:pass@proxy.example.com:8080
